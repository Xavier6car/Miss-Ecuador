rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /candidates/{fileName} {
      // Las fotos de candidatas son públicas para verlas (la app las
      // muestra con <img> sin autenticación).
      allow read: if true;

      // Cualquier usuario logueado puede subir/reemplazar fotos, hasta
      // 5MB y solo imágenes. No filtramos por rol (admin/colaborador)
      // acá porque las reglas de Storage de este proyecto no tienen
      // disponible firestore.get() para consultar Firestore desde acá
      // (da "Function not found: [firestore.get]"). La restricción real
      // por rol ya la hace la UI: el botón de subir foto solo aparece
      // para admin/colaborador en la app.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
