# Copia este archivo a ".env" y reemplaza con los valores de tu proyecto Firebase.
# Firebase Console -> Configuración del proyecto -> Tus apps -> Config del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID del primer administrador (opcional, ver README para cómo asignarlo).
